{
  "manifest_version": 3,
  "name": "PariView 시청 설정",
  "version": "0.3.1",
  "homepage_url": "https://pariview-production.up.railway.app/#chrome",
  "description": "PariView에서 고른 소리·밝기·대비를 크롬의 다른 영상에도 적용해요",
  "permissions": ["storage"],
  "action": {
    "default_title": "PariView 시청 설정",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["settings.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
