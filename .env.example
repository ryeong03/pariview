# PariView server configuration template
# Copy to your deploy environment (e.g. Railway variables). Never commit real values.
# The server reads these from the process environment; it does not load .env files itself.

HOST=127.0.0.1
PORT=4178

# AI recommendation (optional — without these, built-in default suggestions are used)
PARIVIEW_AI_ENABLED=0
PARIVIEW_AI_MODEL=
ANTHROPIC_API_KEY=

# Optional: Claude Messages API-compatible gateway (e.g. LiteLLM)
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Optional limits and diagnostics
PARIVIEW_AI_MAX_CALLS_PER_HOUR=60
PARIVIEW_AI_DEBUG=0
